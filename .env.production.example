# ── App - Production
NODE_ENV=production
PORT=3100

# ── Database (MariaDB / App Runner)
# App Runner inyecta DATABASE_CREDENTIALS_JSON desde Secrets Manager. El
# entrypoint construye DATABASE_URL y deriva DB_HOST/DB_PORT sin imprimirlos.
# Para un despliegue self-hosted se puede definir DATABASE_URL directamente.
# DATABASE_URL=mysql://user:password@db-host:3306/image_repo
DB_NAME=image_repo

# ── Object Storage (S3-compatible)
# En AWS (App Runner) se usa S3 real SIN endpoint ni credenciales estáticas:
# el SDK resuelve región y credenciales desde la cadena por defecto
# (instance role de App Runner). Deja OBJECT_STORE_ENDPOINT_URL,
# OBJECT_STORE_ACCESS_KEY y OBJECT_STORE_SECRET_KEY sin definir.
OBJECT_STORE_BUCKET=edge-captures-dev-685538571046
OBJECT_STORE_REGION=us-east-1
RUN_DB_SEED=false

# ── Ingesta edge (P4-2.1)
# Token compartido de `POST /api/edge-captures` (`Authorization: Bearer <token>`).
# En App Runner NO se define aquí: se inyecta en runtime desde Secrets Manager
# (referencia al secreto del servicio). Este es solo un PLACEHOLDER: nunca
# pongas una credencial real en un archivo versionado. Debe tener >= 32
# caracteres en el valor real.
EDGE_INGEST_TOKEN=PON-AQUI-EL-TOKEN-DESDE-SECRETS-MANAGER

# ── Credenciales de RDS en runtime (App Runner)
# DATABASE_URL y DB_HOST/DB_PORT NO se definen en App Runner: el entrypoint del
# contenedor los construye desde el JSON del secreto gestionado de RDS
# (`DATABASE_CREDENTIALS_JSON`, inyectado en runtime) más DB_NAME. Deja estas
# dos variables como referencia de forma; el valor real nunca va en Git.
# DATABASE_CREDENTIALS_JSON={"username":"...","password":"...","host":"...","port":3306}

# Variante self-hosted (MinIO/S3-compatible): descomenta y rellena endpoint y
# credenciales (ambas juntas o ninguna) para dejar de usar la cadena por defecto.
# OBJECT_STORE_ENDPOINT_URL=https://minio-host:9000
# OBJECT_STORE_FORCE_PATH_STYLE=true
# OBJECT_STORE_ACCESS_KEY=minio-access-key
# OBJECT_STORE_SECRET_KEY=minio-secret-key

# Tamaño máximo permitido por imagen: 5 MB.
MAX_UPLOAD_SIZE_BYTES=5242880

# Servicio Python interno del clasificador (no se acepta una URL por request).
MLFLOW_TRACKING_URI=http://mlflow:5000
CLASSIFIER_INFERENCE_URL=http://classifier-inference:8300
CLASSIFIER_INFERENCE_TIMEOUT_MS=30000
SELECTED_MODEL_PATH=/pipeline/reports/classifier/selected-model.json

# ── Data Quality pipeline (SPEC-PIPE-001, APP-07)
# En despliegue real, montar pipeline/data/interim/ (la salida real de
# `dvc repro`, no contracts/) y quality.yaml donde la pipeline los escribe,
# y apuntar estas rutas ahí.
PIPELINE_OUTPUT_DIR=/data/pipeline-output
QUALITY_POLICY_PATH=/data/quality.yaml

# ── Dataset Copilot (APP-06 / APP-10)
# Requerida solo para que el agente responda preguntas de verdad; sin ella el
# servicio `copilot` responde 503 en vez de tronar (ver .env.example, misma
# variable).
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-4-5
