# ── App
NODE_ENV=development
PORT=3000

# ── Database (MariaDB)
# Cadena de conexión usada por Drizzle/mysql2.
DATABASE_URL=mysql://root:password@localhost:3306/image_repo

# Variables individuales opcionales.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=image_repo

# ── Object Storage (S3-compatible)
# MariaDB solo guarda metadatos; los binarios van a un almacén de objetos.
#
# LOCAL: MinIO mediante endpoint + credenciales explícitas (path-style).
# AWS (App Runner): S3 real — se omiten OBJECT_STORE_ENDPOINT_URL,
# OBJECT_STORE_ACCESS_KEY y OBJECT_STORE_SECRET_KEY y el SDK resuelve la
# región y las credenciales por su cadena por defecto (instance role).
OBJECT_STORE_BUCKET=image-annotations
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORE_FORCE_PATH_STYLE=true
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
RUN_DB_SEED=true
#
# Las dos credenciales deben configurarse juntas o ninguna; un par incompleto
# hace fallar el arranque. Nunca se versionan valores reales (ver .gitignore).

# Tamaño máximo permitido por imagen: 5 MB.
MAX_UPLOAD_SIZE_BYTES=5242880

# Servicio Python interno del clasificador (no se acepta una URL por request).
MLFLOW_TRACKING_URI=http://localhost:5000
CLASSIFIER_INFERENCE_URL=http://localhost:8300
CLASSIFIER_INFERENCE_TIMEOUT_MS=30000
SELECTED_MODEL_PATH=../pipeline/reports/classifier/selected-model.json

# ── Data Quality pipeline (SPEC-PIPE-001, APP-07)
# Dónde vive la salida REAL de la pipeline (quality.json/splits.json/
# versions.json, escritos por pipeline/dvc.yaml en pipeline/data/interim/ --
# no contracts/, que es solo el mock versionado de APP-01/APP-05) y
# pipeline/quality.yaml. En Docker Compose el backend los monta como volumen
# (ver docker-compose.yml) y no hace falta tocar esto. Fuera de Docker
# (backend corriendo con `npm run dev` desde backend/), los defaults ya
# apuntan a las rutas reales del monorepo.
PIPELINE_OUTPUT_DIR=../pipeline/data/interim
QUALITY_POLICY_PATH=../pipeline/quality.yaml

# ── Dataset Copilot (APP-06 / APP-10)
# Solo lo lee `docker compose up` (servicio `copilot`, docker-compose.yml) --
# Compose carga automáticamente el .env de esta misma carpeta para sustituir
# ${ANTHROPIC_API_KEY}/${COPILOT_MODEL} ahí. Fuera de Docker, el Copilot
# (`python -m dataset_quality.copilot` desde pipeline/) usa en cambio
# pipeline/.env, no este archivo.
#
# Requerida solo para que el agente responda preguntas de verdad
# (AnthropicProvider.from_settings, agent.py) -- sin ella, POST /query
# devuelve un 503 limpio en vez de tronar, y el servidor MCP y sus
# herramientas de solo lectura siguen funcionando igual. Nunca se versiona
# (ver .gitignore).
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-4-5
